# Jira connection settings belong in Cursor MCP only:
# %USERPROFILE%\.cursor\mcp.json → mcpServers.jira-sso.env
#
# Example mcp.json fragment:
#   "jira-sso": {
#     "command": "node",
#     "args": ["C:/path/to/jira-mcp-oauth/src/index.js"],
#     "env": {
#       "JIRA_BASE_URL": "https://jira.company.com",
#       "JIRA_REST_API_PREFIX": "/rest/api/2",
#       "JIRA_DESCRIPTION_FORMAT": "auto",
#       "JIRA_LOGIN_WAIT_SECONDS": "90"
#     }
#   }
#
# Auth is SSO-cookie only (run the jira_login tool once). There is no token mode.
# If browser SSO (jira_login) never saves cookies: delete
# cookies/session-<server-key>.json under this package and retry, completing SSO fully.
#
# Optional: background session keep-alive interval in seconds (default 120; 0 disables)
# Pings immediately on start, then every interval on success.
# JIRA_KEEPALIVE_SECONDS=120
#
# Optional: after a FAILED ping, retry this quickly (seconds) instead of a full interval (default 15)
# JIRA_KEEPALIVE_RETRY_SECONDS=15
#
# Optional: consecutive auth failures before the stale cookie file is auto-deleted (default 3; 0 disables)
# JIRA_STALE_COOKIE_FAILS=3
#
# Optional: max attachment upload size in bytes (default 10485760)
# JIRA_MAX_ATTACHMENT_BYTES=
#
# Data Center often uses /rest/api/2 (plain-text description; list_projects uses GET /project).
# Cloud uses /rest/api/3 (ADF description; project search API). Override if needed:
# JIRA_REST_API_PREFIX=/rest/api/2
# JIRA_DESCRIPTION_FORMAT=auto|adf|plain
